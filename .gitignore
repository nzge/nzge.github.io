# ---------------------------------------------------------------
# Jekyll build output
#
# _site/ is regenerated by `jekyll build` and published to gh-pages
# by .github/workflows/deploy.yml. It was previously tracked, which
# duplicated ~790 MB of assets/ into the repo.
#
# NOTE: _config.yml has its own `exclude:` list. That controls what
# Jekyll copies into the built site — it does not affect what git
# tracks. The two lists overlap but serve different purposes.
# ---------------------------------------------------------------
_site/
.jekyll-cache/
.jekyll-metadata

# Sass / SCSS caches
.sass-cache/
.scss-cache/

# Ruby / Bundler
# (Gemfile and Gemfile.lock stay tracked — CI runs `bundle install`)
.bundle/
vendor/bundle/
vendor/cache/
vendor/gems/
vendor/ruby/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Python (scripts and figure tooling)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets and credentials
# (was previously "passwords.txt" WITH quotes, which git matches
#  literally — it never actually ignored passwords.txt)
passwords.txt
.env
.env.*
*.pem
*.key
*.p12
secrets.yml

# OS cruft
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
